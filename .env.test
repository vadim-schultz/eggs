# Dummy Supabase values for the vitest ("test" mode) environment. Not real
# credentials — vitest's jsdom tests construct a Supabase client at module
# load time (src/lib/supabaseClient.ts), so VITE_SUPABASE_URL/ANON_KEY must
# resolve to *something*, but no test makes a real network call with them.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=test-anon-key
