# Supabase project URL and anon (public) key — Project Settings → API in the
# Supabase dashboard. Never put the service_role key here; see chapter 1's
# "Manual configuration" section.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google OAuth client for local Supabase Auth (supabase/config.toml's
# [auth.external.google] reads these — not consumed by the frontend build).
# See chapter 3's "Manual configuration" section.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
